<style>
  :root {
    /* Tu paleta New Wave */
    --color-gold: #8b734e;
    --color-beige: #dbd9cc;
    --color-black: #000000;
    --color-navy: #002b49;
    --color-offwhite: #f3f3f1;
    
    /* Tus fuentes */
    --font-serif: 'Source Serif Pro', serif;
    --font-sans: 'Futura', 'Century Gothic', sans-serif;
  }

  body {
    background-color: var(--color-offwhite);
    color: var(--color-black);
    font-family: var(--font-serif);
    margin: 0;
    padding: 2rem;
  }

  h1 {
    font-family: var(--font-sans);
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
  }
  
  /* Detalle decorativo New Wave bajo el título */
  h1::after {
      content: '';
      display: block;
      width: 60px;
      height: 4px;
      background-color: var(--color-gold);
      margin: 1rem auto 0;
  }

  /* --- GRID LAYOUT --- */
  .blog-grid {
    display: grid;
    /* Columnas más anchas para acomodar el diseño horizontal */
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); 
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- DISEÑO DE TARJETA INTERACTIVA --- */
  .blog-card {
    display: flex; /* Activa el diseño lado-a-lado */
    background: #ffffff;
    border: 2px solid var(--color-beige);
    /* La magia de la transición interactiva */
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); 
    overflow: hidden; /* Necesario para el zoom de la imagen */
    height: 350px; /* Altura fija para forzar la verticalidad */
  }

  /* --- Contenedor de Imagen Vertical --- */
  .card-image-wrapper {
    flex: 0 0 45%; /* La imagen ocupa el 45% del ancho de la tarjeta */
    position: relative;
    overflow: hidden;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    /* OBJECT-FIT: COVER es clave para imágenes verticales. 
       Recorta la imagen para llenar el espacio sin deformarla. */
    object-fit: cover; 
    transition: transform 0.5s ease; /* Transición suave para el zoom */
  }

  /* --- Contenido de la Tarjeta --- */
  .card-content {
    flex: 1; /* Ocupa el resto del espacio */
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 2px solid var(--color-beige); /* Línea divisoria sutil */
  }

  .card-meta {
      font-family: var(--font-sans);
      font-size: 0.85rem;
      color: var(--color-gold);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      font-weight: bold;
  }

  .card-content h2 {
    font-family: var(--font-sans);
    color: var(--color-navy);
    margin-top: 0;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .card-content p {
      flex-grow: 1; /* Empuja el botón hacia abajo */
      line-height: 1.6;
      /* Cortar texto si es muy largo */
      display: -webkit-box;
      -webkit-line-clamp: 4; /* Número de líneas a mostrar */
      -webkit-box-orient: vertical;
      overflow: hidden;
  }


  /* --- BOTÓN NEW WAVE --- */
  .read-more-btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    background-color: transparent;
    color: var(--color-navy);
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: bold;
    border: 2px solid var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    align-self: flex-start; /* Alinea el botón a la izquierda */
    position: relative;
    z-index: 1;
  }
  
  /* Efecto de llenado del botón al pasar el mouse */
  .read-more-btn::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 0%; height: 100%;
      background-color: var(--color-navy);
      transition: width 0.3s ease;
      z-index: -1;
  }
  
  .read-more-btn:hover {
      color: var(--color-offwhite);
  }
  
  .read-more-btn:hover::before {
      width: 100%;
  }

  /* --- INTERACTIVIDAD PRINCIPAL (HOVER EN LA TARJETA) --- */
  .blog-card:hover {
    /* Mueve la tarjeta arriba y a la izquierda */
    transform: translate(-8px, -8px);
    border-color: var(--color-navy);
    /* Sombra SÓLIDA (0px de blur) en color navy o dorado */
    box-shadow: 10px 10px 0px var(--color-gold);
  }

  /* Zoom en la imagen al hacer hover en la tarjeta */
  .blog-card:hover .card-image-wrapper img {
    transform: scale(1.1);
  }


  /* --- RESPONSIVE (Móvil) --- */
  @media (max-width: 768px) {
      .blog-grid {
           /* Vuelve a una columna en móviles */
          grid-template-columns: 1fr;
      }
      
      .blog-card {
          /* Apila la imagen sobre el texto en móviles */
          flex-direction: column;
          height: auto; /* Altura automática */
      }
      
      .card-image-wrapper {
          height: 250px; /* Altura fija para la imagen en móvil */
          border-bottom: 2px solid var(--color-beige);
      }
      
       .card-content {
           border-left: none;
       }
  }
</style>
