<!-- ══════════════════════════════════════════════════════
     NEW WAVE — SERVICE PORTAL  (www.newwave-germany.de/service-3)
     BLOQUE 1: Script/Style — Optimizely CMS
     ══════════════════════════════════════════════════════ -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400;1,8..60,600&family=Jost:wght@300;400;500;600;700&display=swap');

/* ── RESET scoped ── */
.nw-srv *, .nw-srv *::before, .nw-srv *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── ROOT ── */
.nw-srv {
  font-family: 'Jost', 'Century Gothic', 'Futura', sans-serif;
  background: #f3f3f1;
  color: #002b49;
  -webkit-font-smoothing: antialiased;
  width: 100%;
  overflow-x: hidden;
}

/* ══════════════════════════════════════
   HERO
   ══════════════════════════════════════ */
.nw-srv__hero {
  background: #002b49;
  position: relative;
  overflow: hidden;
}

.nw-srv__hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 18% 55%, rgba(139,115,78,0.16) 0%, transparent 58%),
    radial-gradient(ellipse at 80% 10%, rgba(219,217,204,0.05) 0%, transparent 45%);
  pointer-events: none;
}

.nw-srv__hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 48px;
  display: grid;
  grid-template-columns: 1fr 440px;
  min-height: 400px;
  align-items: stretch;
}

.nw-srv__hero-content {
  padding: 68px 60px 68px 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.nw-srv__hero-eyebrow {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: #8b734e;
  margin-bottom: 22px;
}

.nw-srv__hero-h1-sans {
  font-family: 'Jost', 'Century Gothic', sans-serif;
  font-size: clamp(38px, 4.2vw, 60px);
  font-weight: 700;
  line-height: 1.0;
  letter-spacing: -0.025em;
  color: #ffffff;
}

.nw-srv__hero-h1-serif {
  font-family: 'Source Serif 4', serif;
  font-size: clamp(38px, 4.2vw, 60px);
  font-weight: 300;
  font-style: italic;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #dbd9cc;
  margin-bottom: 26px;
}

.nw-srv__hero-body {
  font-family: 'Source Serif 4', serif;
  font-size: 15px;
  font-weight: 300;
  font-style: italic;
  line-height: 1.78;
  color: rgba(219,217,204,0.65);
  max-width: 390px;
  margin-bottom: 36px;
}

.nw-srv__hero-pills {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.nw-srv__hero-pill {
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(219,217,204,0.55);
  border: 1px solid rgba(219,217,204,0.18);
  padding: 8px 14px;
  text-decoration: none;
  transition: color 0.28s ease, border-color 0.28s ease, background 0.28s ease;
  cursor: pointer;
}

.nw-srv__hero-pill:hover {
  color: #ffffff;
  border-color: #8b734e;
  background: rgba(139,115,78,0.12);
}

/* ── hero image ── */
.nw-srv__hero-image {
  position: relative;
  overflow: hidden;
  background: #001a2e;
  min-height: 400px;
}

.nw-srv__hero-image img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 0.72;
  transition: transform 0.65s cubic-bezier(0.2,0,0,1), opacity 0.4s ease;
}

.nw-srv__hero-image:hover img {
  transform: scale(1.045);
  opacity: 0.84;
}

.nw-srv__season-tag {
  position: absolute;
  bottom: 24px;
  right: 24px;
  background: #ffffff;
  padding: 10px 18px;
  z-index: 2;
  box-shadow: 0 4px 20px rgba(0,0,0,0.22);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.nw-srv__hero-image:hover .nw-srv__season-tag {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.32);
}

.nw-srv__season-tag-label {
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(0,43,73,0.4);
  margin-bottom: 3px;
}

.nw-srv__season-tag-value {
  font-family: 'Source Serif 4', serif;
  font-size: 13px;
  font-weight: 600;
  color: #002b49;
}

/* ══════════════════════════════════════
   SECTION HELPERS
   ══════════════════════════════════════ */
.nw-srv__section {
  padding: 72px 48px;
  max-width: 1200px;
  margin: 0 auto;
}

.nw-srv__section-label {
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: #8b734e;
  margin-bottom: 12px;
}

.nw-srv__section-heading {
  font-family: 'Source Serif 4', serif;
  font-size: clamp(26px, 2.8vw, 36px);
  font-weight: 300;
  color: #002b49;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
  line-height: 1.25;
}

.nw-srv__section-desc {
  font-size: 14px;
  font-weight: 300;
  color: rgba(0,43,73,0.6);
  max-width: 540px;
  margin-bottom: 44px;
  line-height: 1.78;
}

.nw-srv__divider {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 48px;
}

.nw-srv__divider-line {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(139,115,78,0.22), transparent);
}

/* ══════════════════════════════════════
   TOOLS GRID — 4 Cards
   ══════════════════════════════════════ */
.nw-srv__tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.nw-srv__tool-card {
  background: #ffffff;
  border: 1px solid rgba(0,43,73,0.07);
  padding: 36px 28px 32px;
  position: relative;
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.2,0,0,1), box-shadow 0.35s ease;
}

.nw-srv__tool-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, #8b734e, #dbd9cc);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s ease;
}

.nw-srv__tool-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 44px rgba(0,43,73,0.1);
}

.nw-srv__tool-card:hover::after {
  transform: scaleX(1);
}

.nw-srv__tool-icon {
  width: 40px;
  height: 40px;
  border: 1px solid rgba(139,115,78,0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b734e;
  font-size: 17px;
  margin-bottom: 20px;
}

.nw-srv__tool-title {
  font-family: 'Source Serif 4', serif;
  font-size: 17px;
  font-weight: 600;
  color: #002b49;
  margin-bottom: 10px;
  line-height: 1.3;
}

.nw-srv__tool-text {
  font-size: 13px;
  font-weight: 300;
  color: rgba(0,43,73,0.58);
  line-height: 1.68;
}

/* ══════════════════════════════════════
   BENTO HIGHLIGHT — 3 Editorial Cards
   ══════════════════════════════════════ */
.nw-srv__bento-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 48px 72px;
}

.nw-srv__bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 280px 280px;
  gap: 8px;
}

.nw-srv__bc {
  position: relative;
  overflow: hidden;
  transition: transform 0.38s cubic-bezier(0.2,0,0,1), box-shadow 0.38s ease;
  will-change: transform;
}

.nw-srv__bc:hover {
  transform: scale(1.022);
  z-index: 2;
}

/* Card placements */
.nw-srv__bc--download   { grid-column: 1 / 2; grid-row: 1 / 3; background: #dbd9cc; }
.nw-srv__bc--stammdaten { grid-column: 2 / 3; grid-row: 1;      background: #002b49; }
.nw-srv__bc--pantone    { grid-column: 2 / 3; grid-row: 2;      background: #8b734e; }

.nw-srv__bc--download:hover  { box-shadow: 0 12px 40px rgba(0,0,0,0.12); }
.nw-srv__bc--stammdaten:hover { box-shadow: 0 18px 52px rgba(0,0,0,0.32); }
.nw-srv__bc--pantone:hover   { box-shadow: 0 14px 44px rgba(139,115,78,0.5); }

.nw-srv__bc img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.65s cubic-bezier(0.2,0,0,1);
}

.nw-srv__bc:hover img {
  transform: scale(1.06);
}

.nw-srv__bc-inner {
  position: absolute;
  inset: 0;
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.nw-srv__bc-top {}

.nw-srv__bc-eyebrow {
  font-size: 9px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(0,43,73,0.38);
}

.nw-srv__bc-eyebrow--light { color: rgba(255,255,255,0.38); }

.nw-srv__bc-icon-box {
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.55);
  font-size: 14px;
  float: right;
  transition: background 0.25s ease, border-color 0.25s ease;
}

.nw-srv__bc:hover .nw-srv__bc-icon-box {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.35);
}

.nw-srv__bc-bottom {}

.nw-srv__bc-title {
  font-family: 'Jost', 'Century Gothic', sans-serif;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #002b49;
  margin-bottom: 8px;
  line-height: 1.1;
}

.nw-srv__bc-title--light { color: #ffffff; }

.nw-srv__bc-desc {
  font-family: 'Source Serif 4', serif;
  font-style: italic;
  font-size: 13px;
  font-weight: 300;
  color: rgba(0,43,73,0.5);
  line-height: 1.62;
  max-width: 290px;
  margin-bottom: 16px;
}

.nw-srv__bc-desc--light { color: rgba(255,255,255,0.58); }

.nw-srv__bc-tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.nw-srv__bc-tag {
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 4px 8px;
  border: 1px solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.45);
}

/* Arrow CTA (reusable) */
.nw-srv__cta-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #002b49;
  text-decoration: none;
  transition: gap 0.25s ease, color 0.25s ease;
}

.nw-srv__cta-link::after {
  content: '→';
  font-size: 13px;
  transition: transform 0.25s ease;
}

.nw-srv__bc:hover .nw-srv__cta-link { gap: 14px; color: #8b734e; }
.nw-srv__bc:hover .nw-srv__cta-link::after { transform: translateX(4px); }

.nw-srv__cta-link--light { color: rgba(255,255,255,0.7); }
.nw-srv__bc:hover .nw-srv__cta-link--light { color: #ffffff; gap: 14px; }

/* ══════════════════════════════════════
   BILDER HERUNTERLADEN
   ══════════════════════════════════════ */
.nw-srv__bilder-layout {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 16px;
  align-items: start;
}

.nw-srv__bilder-main {
  position: relative;
  overflow: hidden;
  background: #dbd9cc;
}

.nw-srv__bilder-main img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.65s cubic-bezier(0.2,0,0,1);
}

.nw-srv__bilder-main:hover img {
  transform: scale(1.04);
}

.nw-srv__bilder-main-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,43,73,0.72) 0%, transparent 55%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px 30px;
  pointer-events: none;
}

.nw-srv__bilder-main-tag {
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: #8b734e;
  margin-bottom: 6px;
}

.nw-srv__bilder-main-count {
  font-family: 'Source Serif 4', serif;
  font-size: 22px;
  font-weight: 300;
  font-style: italic;
  color: #ffffff;
}

.nw-srv__bilder-cats {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nw-srv__bilder-cat {
  display: flex;
  gap: 14px;
  background: #ffffff;
  border: 1px solid rgba(0,43,73,0.06);
  overflow: hidden;
  transition: box-shadow 0.3s ease, transform 0.3s ease;
  cursor: pointer;
}

.nw-srv__bilder-cat:hover {
  box-shadow: 0 8px 28px rgba(0,43,73,0.1);
  transform: translateX(3px);
}

.nw-srv__bilder-cat-thumb {
  flex-shrink: 0;
  width: 90px;
  height: 72px;
  position: relative;
  overflow: hidden;
  background: #dbd9cc;
}

.nw-srv__bilder-cat-thumb img {
  width: 100%;
  height: 72px;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.nw-srv__bilder-cat:hover .nw-srv__bilder-cat-thumb img {
  transform: scale(1.08);
}

.nw-srv__bilder-cat-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,43,73,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.28s ease;
  pointer-events: none;
}

.nw-srv__bilder-cat:hover .nw-srv__bilder-cat-overlay {
  opacity: 1;
}

.nw-srv__bilder-cat-dl {
  font-size: 20px;
  color: #ffffff;
}

.nw-srv__bilder-cat-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12px 14px 12px 0;
}

.nw-srv__bilder-cat-label {
  font-size: 9px;
  letter-spacing: 0.20em;
  text-transform: uppercase;
  color: #8b734e;
  margin-bottom: 4px;
}

.nw-srv__bilder-cat-name {
  font-family: 'Source Serif 4', serif;
  font-size: 14px;
  font-weight: 600;
  color: #002b49;
  margin-bottom: 3px;
}

.nw-srv__bilder-cat-meta {
  font-size: 11px;
  font-weight: 300;
  color: rgba(0,43,73,0.42);
  letter-spacing: 0.04em;
}

.nw-srv__bilder-all-btn {
  display: block;
  margin-top: 4px;
  padding: 14px 20px;
  background: #002b49;
  color: #dbd9cc;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.20em;
  text-transform: uppercase;
  text-decoration: none;
  text-align: center;
  transition: background 0.3s ease, color 0.3s ease;
}

.nw-srv__bilder-all-btn:hover {
  background: #8b734e;
  color: #ffffff;
}

/* ══════════════════════════════════════
   TUTORIALS — 2×2 Grid
   ══════════════════════════════════════ */
.nw-srv__tutorials-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.nw-srv__tutorial-card {
  display: flex;
  gap: 22px;
  background: #ffffff;
  border: 1px solid rgba(0,43,73,0.06);
  padding: 26px;
  transition: box-shadow 0.35s ease, transform 0.35s ease;
}

.nw-srv__tutorial-card:hover {
  box-shadow: 0 8px 32px rgba(0,43,73,0.09);
  transform: translateY(-2px);
}

.nw-srv__tutorial-thumb {
  flex-shrink: 0;
  width: 110px;
  height: 82px;
  background: #002b49;
  overflow: hidden;
  position: relative;
}

.nw-srv__tutorial-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.nw-srv__play {
  width: 30px;
  height: 30px;
  border: 1.5px solid rgba(255,255,255,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 10px;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
  transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
}

.nw-srv__tutorial-card:hover .nw-srv__play {
  background: rgba(255,255,255,0.18);
  border-color: #ffffff;
  transform: translate(-50%, -50%) scale(1.08);
}

.nw-srv__tutorial-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nw-srv__tutorial-tag {
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: #8b734e;
  margin-bottom: 7px;
}

.nw-srv__tutorial-title {
  font-family: 'Source Serif 4', serif;
  font-size: 15px;
  font-weight: 600;
  color: #002b49;
  margin-bottom: 6px;
  line-height: 1.3;
}

.nw-srv__tutorial-desc {
  font-size: 12.5px;
  font-weight: 300;
  color: rgba(0,43,73,0.52);
  line-height: 1.62;
}

/* ══════════════════════════════════════
   DOWNLOAD BANNER (dark navy)
   ══════════════════════════════════════ */
.nw-srv__dl-banner {
  background: #002b49;
  position: relative;
  overflow: hidden;
}

.nw-srv__dl-banner::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 55%;
  height: 100%;
  background: radial-gradient(ellipse at 80% 50%, rgba(139,115,78,0.13) 0%, transparent 62%);
  pointer-events: none;
}

.nw-srv__dl-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 64px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48px;
  position: relative;
}

.nw-srv__dl-text .nw-srv__section-heading { color: #ffffff; margin-bottom: 12px; }
.nw-srv__dl-text .nw-srv__section-label   { color: #8b734e; }

.nw-srv__dl-text p {
  font-size: 14px;
  font-weight: 300;
  color: rgba(219,217,204,0.68);
  line-height: 1.78;
  max-width: 440px;
}

.nw-srv__dl-items {
  display: flex;
  gap: 14px;
  flex-shrink: 0;
}

.nw-srv__dl-item {
  width: 128px;
  padding: 24px 14px;
  border: 1px solid rgba(139,115,78,0.3);
  text-align: center;
  cursor: pointer;
  transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
}

.nw-srv__dl-item:hover {
  border-color: #8b734e;
  background: rgba(139,115,78,0.1);
  transform: translateY(-3px);
}

.nw-srv__dl-icon {
  font-size: 20px;
  color: #8b734e;
  margin-bottom: 12px;
}

.nw-srv__dl-name {
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #dbd9cc;
}

/* ══════════════════════════════════════
   FEATURE SPLIT — Microshop
   ══════════════════════════════════════ */
.nw-srv__feature {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 420px;
}

.nw-srv__feature-img {
  position: relative;
  overflow: hidden;
  background: #dbd9cc;
}

.nw-srv__feature-img img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.65s cubic-bezier(0.2,0,0,1);
}

.nw-srv__feature:hover .nw-srv__feature-img img {
  transform: scale(1.035);
}

.nw-srv__feature-content {
  background: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 64px 56px;
}

.nw-srv__feature-content .nw-srv__section-heading { margin-bottom: 16px; }

.nw-srv__feature-content p {
  font-size: 14px;
  font-weight: 300;
  color: rgba(0,43,73,0.62);
  line-height: 1.78;
  margin-bottom: 32px;
  max-width: 400px;
}

/* ── Buttons ── */
.nw-srv__btn {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #002b49;
  border: 1px solid #002b49;
