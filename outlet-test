<style>
  /* --- Scroll Suave (Smooth Scrolling) --- */
  html {
    scroll-behavior: smooth;
  }

  .mo section {
    scroll-margin-top: 40px;
  }

  .mo {
    /* --- New Wave · Opción C · Alto contraste --- */
    --navy:    #002b49;   /* azul New Wave · ahora uso puntual */
    --navy-dk: #001b30;   /* azul profundo · footer */
    --navy-2:  #0c3b5e;   /* azul medio · hovers puntuales */
    --gold:    #8b734e;   /* dorado · solo líneas y texto fino */
    --gold-lt: #b09a72;   /* dorado claro · detalles sobre fondo oscuro */
    --cream:   #f3f3f1;   /* off-white · fondo principal */
    --cream-2: #e7e4dc;   /* arena suave */
    --sand:    #dbd9cc;   /* arena · bloques planos */
    --ink:     #000000;   /* negro · texto y bloques protagonistas */
    --ink-2:   #4a4a48;   /* gris cálido · texto secundario */
    --line:    #d6d3c8;   /* líneas/bordes arena */

    --serif: 'Source Serif Pro', serif;
    --sans:  'Futura', 'Century Gothic', sans-serif;

    /* Fondo plano: se quitaron los radial-gradient para un look más limpio */
    background: var(--cream);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.6;
    overflow: hidden;
  }
  .mo *, .mo *::before, .mo *::after { box-sizing: border-box; }
  .mo h1, .mo h2, .mo h3 { font-family: var(--serif); font-weight: 500; margin: 0; }
  .mo p { margin: 0; }

  /* ---------- Animaciones base ---------- */
  @keyframes mo-rise   { from { opacity: 0; transform: translateY(34px); } to { opacity: 1; transform: none; } }
  @keyframes mo-fade   { from { opacity: 0; } to { opacity: 1; } }
  @keyframes mo-grow   { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .mo [data-rise] { opacity: 0; animation: mo-rise .9s cubic-bezier(.2,.7,.2,1) forwards; }
  .mo [data-d1] { animation-delay: .10s; }
  .mo [data-d2] { animation-delay: .22s; }
  .mo [data-d3] { animation-delay: .34s; }
  .mo [data-d4] { animation-delay: .46s; }
  .mo [data-d5] { animation-delay: .58s; }
  .mo [data-d6] { animation-delay: .70s; }

  @media (prefers-reduced-motion: reduce) {
    .mo [data-rise] { animation: none; opacity: 1; }
  }

  /* ---------- Topbar ---------- */
  .mo__topbar {
    position: relative; z-index: 2;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px;
    padding: 11px 48px;
    background: var(--ink);
    color: #eceae3;
    font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
  }
  .mo__topbar b { color: var(--gold-lt); font-weight: 600; }

  /* ---------- Header ---------- */
  .mo__header {
    position: relative; z-index: 2;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 20px;
    padding: 28px 48px; border-bottom: 1px solid var(--line);
    background: var(--cream);
  }
  .mo__brand-name { font-family: var(--serif); font-size: 28px; font-weight: 600; line-height: 1; color: var(--ink); }
  .mo__brand-sub  { font-size: 10px; letter-spacing: .45em; color: var(--gold); margin-top: 5px; }
  .mo__nav { display: flex; flex-wrap: wrap; gap: 26px; font-size: 13px; letter-spacing: .04em; color: var(--ink-2); }
  .mo__nav a { color: inherit; text-decoration: none; position: relative; padding-bottom: 4px; }
  .mo__nav a::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 1.5px; width: 100%;
    background: var(--ink); transform: scaleX(0); transform-origin: left;
    transition: transform .35s cubic-bezier(.2,.7,.2,1);
  }
  .mo__nav a:hover { color: var(--ink); }
  .mo__nav a:hover::after { transform: scaleX(1); }

  .mo__btn {
    display: inline-block; text-decoration: none; cursor: pointer;
    font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase;
    transition: transform .3s, background .3s, color .3s, border-color .3s;
  }
  .mo__btn--outline { border: 1px solid var(--ink); color: var(--ink); padding: 11px 22px; background: transparent; }
  .mo__btn--outline:hover { background: var(--ink); color: var(--cream); transform: translateY(-2px); }

  /* ---------- Hero ---------- */
  .mo__hero { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr .95fr; }
  .mo__hero-copy { padding: 86px 56px; display: flex; flex-direction: column; justify-content: center; }
  .mo__eyebrow {
    display: inline-block; font-size: 12px; letter-spacing: .34em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 22px; padding-left: 56px; position: relative;
  }
  .mo__eyebrow::before {
    content: ""; position: absolute; left: 0; top: 50%; width: 42px; height: 1px;
    background: var(--gold); transform: scaleX(0); transform-origin: left;
    animation: mo-grow .8s .5s forwards;
  }
  .mo__hero h1 { font-size: clamp(42px, 6vw, 68px); line-height: 1.02; margin-bottom: 26px; color: var(--ink); }
  /* Acento puntual en oro · sin shimmer animado */
  .mo__hero h1 em { font-style: italic; color: var(--gold); }
  .mo__lead { font-size: 16.5px; line-height: 1.8; color: var(--ink-2); max-width: 460px; margin-bottom: 36px; }
  .mo__cta-row { display: flex; flex-wrap: wrap; gap: 14px; }
  .mo__btn--primary {
    color: var(--cream); padding: 16px 34px; border: none;
    background: var(--ink);
  }
  .mo__btn--primary:hover { transform: translateY(-3px); background: var(--navy); }
  .mo__btn--soft { border: 1px solid var(--line); color: var(--ink); padding: 16px 30px; background: transparent; }
  .mo__btn--soft:hover { transform: translateY(-3px); border-color: var(--ink); }

  .mo__brandline { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; margin-top: 54px; font-family: var(--serif); font-size: 22px; color: #9a958a; }
  .mo__brandline span.sep { color: var(--gold); }
  .mo__brandline b { font-weight: 500; color: var(--ink); transition: color .3s, transform .3s; display: inline-block; }
  .mo__brandline b:hover { color: var(--gold); transform: translateY(-2px); }

  /* Hero media · color plano arena, sin rayado ni shimmer */
  .mo__hero-media {
    position: relative; overflow: hidden; min-height: 600px;
    background: var(--sand);
    display: flex; align-items: flex-end; padding: 30px;
  }
  .mo__hero-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;
  }
  .mo__media-tag { position: relative; z-index: 2; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #6b6b66; }

  /* ---------- Intro ---------- */
  .mo__intro {
    position: relative; z-index: 1;
    padding: 140px 56px;
    background: var(--cream);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .mo__intro-inner { max-width: 780px; margin: 0 auto; text-align: center; }
  .mo__rule { width: 52px; height: 2px; background: var(--gold); margin: 0 auto 26px; border-radius: 2px; }
  .mo__intro h2 { font-size: clamp(28px, 4vw, 36px); margin-bottom: 22px; color: var(--ink); }
  .mo__intro p { font-size: 17px; line-height: 1.9; color: var(--ink-2); }

  /* ---------- Section head ---------- */
  .mo__section { position: relative; z-index: 1; padding: 84px 56px; }
  .mo__section-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; margin-bottom: 42px; }
  .mo__section-head h2 { font-size: clamp(28px, 4vw, 38px); color: var(--ink); }
  .mo__section-tag { font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); }

  /* ---------- Brand cards ---------- */
  .mo__brands { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .mo__card {
    position: relative; background: #fff; border: 1px solid var(--line);
    overflow: hidden; transition: transform .4s cubic-bezier(.2,.7,.2,1), box-shadow .4s;
  }
  .mo__card:hover { transform: translateY(-8px); box-shadow: 0 26px 46px -22px rgba(0,0,0,.35); }
  .mo__card-media {
    position: relative; height: 234px; overflow: hidden;
    background: var(--sand);
  }
  .mo__card-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;
    transition: transform .6s ease;
  }
  .mo__card:hover .mo__card-media img { transform: scale(1.05); }
  .mo__card-media::after {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, transparent 45%, rgba(0,0,0,.5));
    opacity: 0; transition: opacity .4s;
  }
  .mo__card:hover .mo__card-media::after { opacity: 1; }
  .mo__card-body { padding: 26px 26px 30px; position: relative; z-index: 2; background: #fff; }
  .mo__card-body h3 { font-size: 26px; margin-bottom: 8px; color: var(--ink); transition: color .3s; }
  .mo__card:hover .mo__card-body h3 { color: var(--gold); }
  .mo__card-body p { font-size: 14px; line-height: 1.65; color: var(--ink-2); margin-bottom: 16px; }
  .mo__card-link {
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--gold);
    text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
  }
  .mo__card-link span { transition: transform .35s; }
  .mo__card:hover .mo__card-link span { transform: translateX(6px); }

  /* ---------- Sortiment tiles ---------- */
  .mo__range { position: relative; z-index: 1; padding: 84px 56px; background: var(--sand); }
  .mo__range h2 { font-size: clamp(28px, 4vw, 38px); margin-bottom: 40px; color: var(--ink); }
  .mo__range-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .mo__tile {
    position: relative; overflow: hidden;
    background: var(--cream); border: 1px solid var(--line); padding: 24px; height: 132px;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: transform .35s, box-shadow .35s, color .35s;
  }
  .mo__tile::before {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background: var(--ink);
    transform: translateY(101%); transition: transform .4s cubic-bezier(.2,.7,.2,1);
  }
  .mo__tile:hover { transform: translateY(-5px); box-shadow: 0 18px 32px -18px rgba(0,0,0,.5); color: var(--cream); }
  .mo__tile:hover::before { transform: translateY(0); }
  .mo__tile > * { position: relative; z-index: 1; }
  .mo__tile-title { font-family: var(--serif); font-size: 21px; color: var(--ink); transition: color .35s; }
  .mo__tile:hover .mo__tile-title { color: var(--cream); }
  .mo__tile-sub { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #9a958a; transition: color .35s; }
  .mo__tile:hover .mo__tile-sub { color: var(--gold-lt); }

  /* ---------- Hours ---------- */
  .mo__hours { position: relative; z-index: 1; display: grid; grid-template-columns: .92fr 1.08fr; }
  .mo__hours-copy {
    position: relative; overflow: hidden; padding: 84px 56px;
    display: flex; flex-direction: column; justify-content: center;
    background: var(--ink);
    color: #e7e4dc;
  }
  .mo__hours-copy h2 { position: relative; font-size: clamp(28px, 4vw, 38px); margin-bottom: 24px; color: var(--cream); }
  .mo__hours-note { position: relative; font-size: 14px; line-height: 1.7; color: #b6b3aa; margin-bottom: 18px; }
  .mo__hours-row {
    position: relative; display: flex; justify-content: space-between; padding: 18px 0;
    border-top: 1px solid rgba(176,154,114,.35); font-size: 16px;
  }
  .mo__hours-row:last-of-type { border-bottom: 1px solid rgba(176,154,114,.35); }
  .mo__hours-row span:last-child { color: var(--gold-lt); font-weight: 500; }
  .mo__hours-addr { position: relative; font-size: 14px; line-height: 1.7; color: #9a968d; margin-top: 26px; }
  .mo__hours-cta {
    position: relative; align-self: flex-start; margin-top: 30px;
    border: 1px solid var(--gold-lt); color: var(--gold-lt); padding: 13px 26px;
    font-size: 12px; letter-spacing: .12em; text-transform: uppercase; text-decoration: none;
    transition: background .3s, color .3s, transform .3s;
  }
  .mo__hours-cta:hover { background: var(--gold-lt); color: var(--ink); transform: translateY(-2px); }
  .mo__hours-media {
    position: relative; overflow: hidden; min-height: 440px;
    background: var(--sand);
    display: flex; align-items: flex-end; padding: 30px;
  }
  .mo__hours-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;
  }
  .mo__hours-media .mo__media-tag { z-index: 2; }

  /* ---------- Footer ---------- */
  .mo__footer {
    position: relative; z-index: 1;
    background: var(--ink);
    color: #9a968d; padding: 50px 56px;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
    font-size: 12.5px; letter-spacing: .05em;
  }
  .mo__footer-name { font-family: var(--serif); font-size: 22px; color: var(--cream); }
  .mo__footer-links { display: flex; flex-wrap: wrap; gap: 28px; }
  .mo__footer-links a { color: inherit; text-decoration: none; transition: color .3s; }
  .mo__footer-links a:hover { color: var(--gold-lt); }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .mo__hero, .mo__hours { grid-template-columns: 1fr; }
    .mo__brands { grid-template-columns: repeat(2, 1fr); }
    .mo__range-grid { grid-template-columns: repeat(2, 1fr); }
    .mo__hero-copy, .mo__hours-copy { padding: 64px 40px; }
  }
  @media (max-width: 560px) {
    .mo__topbar, .mo__header, .mo__hero-copy, .mo__intro, .mo__section,
    .mo__range, .mo__hours-copy, .mo__footer { padding-left: 24px; padding-right: 24px; }
    .mo__brands, .mo__range-grid { grid-template-columns: 1fr; }
  }
</style>
