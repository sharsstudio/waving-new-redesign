  .nw-brand-item {
    font-family: 'Source Serif Pro', serif;
    font-size: 2.2rem;
    color: var(--nw-beige);
    margin-bottom: 15px;
    text-decoration: none;
    display: block;
    width: fit-content;
    transition: all 0.4s ease;
    position: relative;
    padding-left: 0;
  }

  .nw-brand-item:hover {
    color: var(--nw-blue);
    transform: translateX(10px);
  }

  .nw-brand-item::before {
    content: '—';
    position: absolute;
    left: -25px;
    opacity: 0;
    color: var(--nw-blue);
    transition: all 0.4s ease;
  }
  
  .nw-brand-item:hover::before {
    opacity: 1;
    left: -20px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .nw-intro-wrapper {
      flex-direction: column;
      gap: 50px;
    }
    .nw-intro-text h2 { font-size: 2.2rem; }
    
    .nw-brand-list {
      border-left: none;
      border-top: 2px solid var(--nw-light);
      padding-left: 0;
      padding-top: 30px;
      width: 100%;
    }
