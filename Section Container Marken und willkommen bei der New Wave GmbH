    margin-bottom: 25px;
    color: var(--nw-black);
    opacity: 0.85;
  }

  .nw-strong {
    color: var(--nw-blue);
    font-weight: 700;
  }

  /* === LINK PREMIUM (SIN LÍNEA) === */
  .nw-text-link {
    display: inline-flex; /* Para alinear la flecha */
    align-items: center;
    color: var(--nw-blue);
    font-weight: 700;
    text-decoration: none; /* Sin subrayado */
    border: none; /* Sin borde */
