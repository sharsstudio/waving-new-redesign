  .nw-text-link::after {
    content: '→';
    margin-left: 8px;
    transition: transform 0.3s ease;
    font-family: sans-serif; /* Flecha simple */
  }

  /* Efecto Hover: La flecha se mueve */
  .nw-text-link:hover {
    opacity: 0.8;
  }
