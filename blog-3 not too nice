<style>
  :root {
    --color-gold: #8b734e;
    --color-beige: #dbd9cc;
    --color-black: #000000;
    --color-navy: #002b49;
    --color-offwhite: #f3f3f1;
    --font-serif: 'Source Serif Pro', serif;
    --font-sans: 'Futura', 'Century Gothic', sans-serif;
  }

  body {
    background-color: var(--color-offwhite);
    color: var(--color-black);
    font-family: var(--font-serif);
    margin: 0;
    padding: 2rem;
  }

  h1 {
    font-family: var(--font-serif);
    color: var(--color-navy);
    text-transform: uppercase;
    border-bottom: 4px solid var(--color-gold);
    display: inline-block;
    padding-bottom: 0.5rem;
    margin-bottom: 2rem;
    /* Animación del título */
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
  }

  /* --- GRID LAYOUT (MOSAICO) --- */
  .mosaic-grid {
    display: grid;
    /* 4 columnas en pantallas grandes para acomodar 8 items mejor */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
    grid-auto-flow: dense; 
  }

  /* --- TARJETA BASE --- */
  .post-card {
    background: #fff;
    border: 1px solid var(--color-navy);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    
    /* ESTADO INICIAL PARA ANIMACIÓN: INVISIBLE */
    opacity: 0;
    transform: translateY(30px); /* Un poco más abajo */
    animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  /* Hover Effect: Sombra dura */
  .post-card:hover {
    transform: translateY(-5px); /* Sobreescribe el transform de la animación una vez terminada */
    box-shadow: 8px 8px 0px var(--color-gold);
    z-index: 10;
    border-color: var(--color-gold);
  }

  .post-img {
    width: 100%;
    aspect-ratio: 3/4; /* Formato vertical consistente */
    object-fit: cover;
    border-bottom: 1px solid var(--color-navy);
  }

  .post-content {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    background: var(--color-navy);
    color: #fff;
    padding: 3px 8px;
    text-transform: uppercase;
    align-self: flex-start;
    margin-bottom: 0.5rem;
    letter-spacing: 1px;
  }

  h2 {
    font-family: var(--font-sans);
    color: var(--color-navy);
    font-size: 1.1rem;
    margin: 0.5rem 0;
    line-height: 1.3;
  }

  /* --- EL HERO (Artículo 1) --- */
  .post-card:first-child {
    grid-column: span 2;
    grid-row: span 2;
    border: 2px solid var(--color-navy);
  }

  .post-card:first-child h2 {
    font-size: 2rem;
    margin-top: 1rem;
  }

  /* --- ANIMACIÓN EN CASCADA (Delay loop) --- */
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Retrasos progresivos para los 8 items */
  .post-card:nth-child(1) { animation-delay: 0.1s; }
  .post-card:nth-child(2) { animation-delay: 0.2s; }
  .post-card:nth-child(3) { animation-delay: 0.3s; }
  .post-card:nth-child(4) { animation-delay: 0.4s; }
  .post-card:nth-child(5) { animation-delay: 0.5s; }
  .post-card:nth-child(6) { animation-delay: 0.6s; }
  .post-card:nth-child(7) { animation-delay: 0.7s; }
  .post-card:nth-child(8) { animation-delay: 0.8s; }


  /* --- RESPONSIVE --- */
  @media (max-width: 768px) {
    .mosaic-grid { grid-template-columns: 1fr; }
    .post-card:first-child { grid-column: span 1; grid-row: auto; }
  }
</style>
