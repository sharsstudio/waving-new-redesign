<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+Pro:wght@400;600;700&display=swap');
  :root {
    /* CD */
    --color-gold: #8b734e;
    --color-beige: #dbd9cc;
    --color-black: #000000;
    --color-navy: #002b49;
    --color-offwhite: #f3f3f1;
    
    --font-serif: 'Source Serif Pro', serif;
    --font-sans: 'Futura', 'Century Gothic', sans-serif;
  }

  /* Contenedor principal para centrar el módulo */
  .catalog-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  /* Cabecera del módulo */
  .catalog-header {
    border-bottom: 4px solid var(--color-navy);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .catalog-header h2 {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-navy);
    font-size: 2.5rem;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: 1px;
  }

  .catalog-meta {
    font-family: var(--font-serif);
    color: var(--color-gold);
    text-align: right;
    font-size: 0.9rem;
  }

  /* --- LISTA ESTRUCTURAL --- */
  .catalog-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .catalog-item {
    border-bottom: 1px solid var(--color-navy);
    position: relative;
    transition: background-color 0.3s ease;
  }

  /* Enlace principal (Fila visible) */
  .catalog-link {
    display: flex;
    flex-wrap: nowrap;
    text-decoration: none;
    color: var(--color-navy);
    padding: 1.5rem 0.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Columnas */
  .col-date {
    flex: 0 0 120px;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: #555;
  }

  .col-cat {
    flex: 0 0 140px;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 1px;
    color: var(--color-gold);
  }

  .col-title {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 1.4rem;
    font-weight: normal;
    transition: transform 0.3s ease, font-weight 0.3s ease;
  }

  .col-icon {
    flex: 0 0 40px;
    text-align: right;
    font-size: 1.5rem;
    opacity: 0; 
    transition: opacity 0.3s ease, transform 0.3s ease;
    color: var(--color-gold);
  }

  /* --- CONTENIDO OCULTO (REVEAL) --- */
  .item-reveal {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.19, 1, 0.22, 1);
    display: flex;
    align-items: flex-start;
    background-color: var(--color-beige);
    padding: 0 1.5rem; /* Padding horizontal fijo, vertical animado */
  }

  .item-reveal img {
    height: 0; /* Se anima en hover */
    width: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    margin-right: 2rem;
    border: 1px solid var(--color-navy);
    box-shadow: 6px 6px 0 var(--color-gold); /* Sombra sólida New Wave */
    transition: height 0.5s ease;
  }

  .reveal-text {
    flex: 1;
    font-family: var(--font-serif);
    line-height: 1.6;
    color: var(--color-black);
    opacity: 0;
    transform: translateY(15px);
    transition: all 0.4s ease 0.1s;
  }

  .read-more-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-weight: bold;
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
  }

  /* --- INTERACCIONES HOVER --- */
  .catalog-item:hover {
    background-color: #ffffff;
  }

  .catalog-item:hover .col-title {
    transform: translateX(15px);
    font-weight: bold;
  }

  .catalog-item:hover .col-icon {
    opacity: 1;
    transform: translateX(-5px);
  }

  /* Abrir el acordeón */
  .catalog-item:hover .item-reveal {
    max-height: 400px; /* Altura suficiente para contenido */
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  
  .catalog-item:hover .item-reveal img {
    height: 250px; /* Altura final de imagen */
  }

  .catalog-item:hover .reveal-text {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- RESPONSIVE MOBILE --- */
  @media (max-width: 768px) {
    .col-date, .col-cat { display: none; } /* responsives Layout für Handys */
    .col-title { font-size: 1.1rem; }
    .item-reveal { flex-direction: column; }
    .item-reveal img { margin-bottom: 1rem; width: 100%; height: auto; object-fit: cover;}
    .catalog-item:hover .item-reveal img { height: 200px; width: 100%; }
  }
</style>
